# TwoToe configuration. Only TWOTOE_* settings belong here, never secrets.
# Local model tag for Ollama (cloud tags are refused).
TWOTOE_MODEL=gemma4:e4b
# Ollama endpoint (loopback only).
TWOTOE_OLLAMA_URL=http://127.0.0.1:11434
# Extra project roots, separated by ';' on Windows.
TWOTOE_ROOTS=
# Set to IN to receive India-only FYI items.
TWOTOE_REGION=
# Telemetry is off unless set to 1.
TWOTOE_TELEMETRY=0
